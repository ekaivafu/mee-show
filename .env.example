# ==================== SERVER CONFIGURATION ====================
NODE_ENV=development
PORT=3000

# ==================== DATABASE CONFIGURATION ====================
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/meesho_loot
DB_PASSWORD=postgres

# ==================== AUTHENTICATION ====================
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=30d

# ==================== TELEGRAM BOT ====================
TG_BOT_TOKEN=
TG_WEBAPP_URL=https://your-service-name.onrender.com
ADMIN_TELEGRAM=tgekaiva

# ==================== MEESHO API (For Proxy) ====================
MEESHO_API_BASE_URL=https://www.meesho.com/api
MEESHO_PROXY_ENABLED=false

# ==================== RATE LIMITING ====================
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100

# ==================== FEATURES ====================
SIGNUP_BONUS_AMOUNT=170
ACCOUNT_POOL_PRICE=40
ENABLE_BULK_IMPORT=true
